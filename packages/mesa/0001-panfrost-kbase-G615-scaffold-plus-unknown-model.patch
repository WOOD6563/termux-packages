+++ b/src/panfrost/tools/panfrost_gpuid_probe.c
@@ -0,0 +1,135 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Prints the raw 32-bit GPU_ID2 register, its decoded arch/product
+ * fields, and whether pan_model.c recognizes the result, for whatever
+ * Panfrost/Panthor DRM node is available.
+ *
+ * This exists to answer the question the porting task asked first:
+ * "what is the *real* raw GPU_ID value the kernel returns for this
+ * device", rather than trusting a hardcoded literal from a fork. It only
+ * covers the DRM (panfrost/panthor) path, since that's the only path
+ * this tree has a verified ioctl ABI for -- see kbase_kmod.c for why the
+ * /dev/mali0 (kbase) path can't be probed the same way yet.
+ *
+ * Usage: panfrost_gpuid_probe [/dev/dri/renderDXXX]
+ * With no argument, tries every /dev/dri/renderD12{8..255} node and
+ * reports on the first one that answers to the panfrost or panthor DRM
+ * driver.
+ */
+
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include <lib/kmod/pan_kmod.h>
+#include <model/pan_model.h>
+
+static void
+report(int fd, const char *path)
+{
+   struct pan_kmod_dev *dev =
+      pan_kmod_dev_create(fd, PAN_KMOD_DEV_FLAG_OWNS_FD, NULL);
+
+   if (!dev) {
+      printf("%s: not a panfrost/panthor DRM node (or too old)\n", path);
+      return;
+   }
+
+   uint64_t gpu_id = dev->props.gpu_id;
+   uint32_t variant = dev->props.gpu_variant;
+   unsigned arch = pan_arch(gpu_id);
+   uint32_t prod_id = pan_prod_id(gpu_id);
+   const struct pan_model *model = pan_get_model(gpu_id, variant);
+
+   printf("%s:\n", path);
+   printf("  raw gpu_id       : 0x%08" PRIx64 "\n", gpu_id);
+   printf("  gpu_variant      : %u\n", variant);
+   printf("  decoded arch     : %u\n", arch);
+   printf("  decoded prod_id  : 0x%06x  (arch_major=%u arch_minor=%u "
+          "product_major=%u)\n",
+          prod_id, PAN_ARCH_MAJOR(gpu_id), PAN_ARCH_MINOR(gpu_id),
+          PAN_PRODUCT_MAJOR(gpu_id));
+   printf("  arch_rev         : %u\n", PAN_ARCH_REV(gpu_id));
+   printf("  model            : %s\n",
+          model ? model->name : "*** UNRECOGNIZED -- add a pan_model.c entry ***");
+
+   if (!model) {
+      printf("\n  No pan_model_list[] entry matches "
+             "PAN_PROD_ID(%u, %u, %u) with variant %u.\n"
+             "  Do not guess this value -- add it to "
+             "src/panfrost/model/pan_model.c using exactly the numbers "
+             "printed above.\n",
+             PAN_ARCH_MAJOR(gpu_id), PAN_ARCH_MINOR(gpu_id),
+             PAN_PRODUCT_MAJOR(gpu_id), variant);
+   }
+
+   if (arch == 11) {
+      printf("\n  arch 11 (4th-gen Valhall: Mali-G615/G715) has no "
+             "genxml/command-stream support in this Mesa tree yet "
+             "(no v11.xml, no panfrost_cmdstream_screen_init_v11). "
+             "Opening this device will succeed but pipe_screen creation "
+             "in pan_screen.c will still fail with 'Unhandled "
+             "architecture major 11' until that's implemented.\n");
+   }
+
+   pan_kmod_dev_destroy(dev);
+}
+
+int
+main(int argc, char **argv)
+{
+   if (argc > 1) {
+      int fd = open(argv[1], O_RDWR | O_CLOEXEC);
+      if (fd < 0) {
+         fprintf(stderr, "failed to open %s: %m\n", argv[1]);
+         return 1;
+      }
+      report(fd, argv[1]);
+      return 0;
+   }
+
+   bool found = false;
+   for (int minor = 128; minor < 192; minor++) {
+      char path[64];
+      snprintf(path, sizeof(path), "/dev/dri/renderD%d", minor);
+
+      int fd = open(path, O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+         continue;
+
+      drmVersionPtr version = drmGetVersion(fd);
+      if (!version) {
+         close(fd);
+         continue;
+      }
+
+      bool is_pan = !strcmp(version->name, "panfrost") ||
+                    !strcmp(version->name, "panthor");
+      drmFreeVersion(version);
+
+      if (!is_pan) {
+         close(fd);
+         continue;
+      }
+
+      found = true;
+      report(fd, path); /* report() takes ownership of fd */
+   }
+
+   if (!found) {
+      fprintf(stderr,
+              "No panfrost/panthor DRM render node found.\n"
+              "If this is an Android device running only the ARM kbase\n"
+              "driver at /dev/mali0, this tool can't probe it yet -- see\n"
+              "the top comment in src/panfrost/lib/kmod/kbase_kmod.c.\n");
+      return 1;
+   }
+
+   return 0;
+}
