diff --git a/src/panfrost/base/include/PORT_NOTES.h b/src/panfrost/base/include/PORT_NOTES.h
new file mode 100644
index 0000000..33e3137
--- /dev/null
+++ b/src/panfrost/base/include/PORT_NOTES.h
@@ -0,0 +1,27 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * This directory intentionally ships empty.
+ *
+ * kbase_kmod.c looks for "base/include/mali_kbase_ioctl.h" via
+ * __has_include() and only compiles the real backend if it's present.
+ * To port kbase support for a specific device:
+ *
+ *   1. Get the ARM kbase kernel driver GPL source matching the version
+ *      running on the target phone (vendor kernel source releases are
+ *      required to publish this; check the SoC vendor's open source
+ *      compliance site, e.g. for MediaTek: mediatek.com/products/opensource,
+ *      or `dmesg | grep -i "mali.*version"` on-device for the exact tag
+ *      to look for).
+ *   2. Copy that driver's include/uapi/{mali_kbase_ioctl.h,
+ *      mali_base_kernel.h, mali_kbase_gpuprops.h} and
+ *      csf/{mali_kbase_csf_ioctl.h,mali_base_csf_kernel.h} in here
+ *      unmodified (they're the kernel/userspace ABI contract, so they
+ *      must match the kernel exactly, not be reconstructed from memory
+ *      or from a different device's dump).
+ *   3. Fill in the PORT_REQUIRED bodies in ../kmod/kbase_kmod.c using
+ *      pan_vX_base.c (from the Panfork fork) as the reference for the
+ *      calling convention of each ioctl.
+ *   4. Build src/panfrost/tools/panfrost_gpuid_probe and run it on the
+ *      real device before touching pan_screen.c / pan_model.c.
+ */
diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
new file mode 100644
index 0000000..3f86fd5
--- /dev/null
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -0,0 +1,278 @@
+/*
+ * Copyright © 2026 (community port, unverified)
+ * SPDX-License-Identifier: MIT
+ *
+ * =====================================================================
+ * READ THIS BEFORE TOUCHING THIS FILE
+ * =====================================================================
+ *
+ * This is a *scaffold*, not a working driver backend. It exists to give
+ * the kbase (ARM proprietary /dev/mali0) protocol a real home in the
+ * modern pan_kmod backend abstraction, but the actual ioctl marshaling
+ * has deliberately NOT been filled in, because the numeric ioctl values
+ * and struct layouts are not available in this tree.
+ *
+ * Why not just port them from the old Panfork fork:
+ *   - The uploaded patch series (main___WOOD6563_mesa-Panfork-android_csf)
+ *     only contains src/panfrost/base/pan_vX_base.c, i.e. the code that
+ *     *calls* KBASE_IOCTL_* symbols. It does not contain
+ *     mali_kbase_ioctl.h / mali_base_kernel.h / csf/mali_kbase_csf_ioctl.h
+ *     (the headers that actually #define those symbols' numeric values
+ *     and struct layouts) -- those must have already existed in the
+ *     Panfork branch *before* this patch series' first commit, so they
+ *     never show up as a diff hunk here.
+ *   - kbase's ioctl ABI has changed across ARM driver releases (see the
+ *     version-gated KBASE_IOCTL_CS_QUEUE_GROUP_CREATE_1_6 in pan_vX_base.c,
+ *     which only exists because an earlier "_1_6"-less struct shape was
+ *     deprecated at some point). Guessing at struct layouts and shipping
+ *     that against a real GPU driver on a real phone risks silent memory
+ *     corruption, not just a clean failure -- so this file refuses to
+ *     guess.
+ *
+ * What to do to make this real:
+ *   1. Pull the actual mali_kbase_ioctl.h / mali_base_kernel.h /
+ *      mali_kbase_gpuprops.h / csf/mali_kbase_csf_ioctl.h /
+ *      csf/mali_base_csf_kernel.h headers matching the kbase driver
+ *      version running on the target device (check
+ *      `dmesg | grep -i mali` or `cat /sys/module/mali_kbase/version`
+ *      on-device) into src/panfrost/base/include/. These are GPL kernel
+ *      headers ARM/vendors publish alongside their kernel source drops;
+ *      they are not reproduced here because this environment could not
+ *      verify which exact version matches your G615 device.
+ *   2. Fill in the ioctl bodies below (each is marked PORT_REQUIRED).
+ *      pan_vX_base.c from the old fork (in the uploaded patch, patch
+ *      102/106) is the reference implementation of the wire protocol
+ *      for each of these calls and can be transcribed close to verbatim
+ *      -- the *logic* in that file is plausible, only the header-defined
+ *      constants it depends on are missing here.
+ *   3. Build src/panfrost/tools/panfrost_gpuid_probe (added by this
+ *      series) against the real device to confirm dev_query_props()
+ *      below returns a sane, non-garbage gpu_id before wiring this into
+ *      pan_screen.c's device-open path.
+ *
+ * See also: gen_macros.h / pan_screen.c do not have any code path for
+ * PAN_ARCH == 11 yet (4th-gen Valhall: Mali-G615/G715). Getting this
+ * backend to open the device is necessary but not sufficient for G615 --
+ * command-stream generation for arch 11 does not exist in this tree
+ * either. See the top-level patch description for details.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "util/macros.h"
+#include "util/os_file.h"
+
+#include "kbase_kmod.h"
+#include "pan_kmod_backend.h"
+
+#if __has_include("base/include/mali_kbase_ioctl.h")
+#define PAN_KBASE_HEADERS_AVAILABLE 1
+#include "base/include/mali_kbase_ioctl.h"
+#else
+#define PAN_KBASE_HEADERS_AVAILABLE 0
+#endif
+
+struct kbase_kmod_dev {
+   struct pan_kmod_dev base;
+
+   /* Raw kbase GPU_PROPS register dump, queried once at dev_create time.
+    * Filled in by kbase_query_gpu_props() (PORT_REQUIRED). */
+   struct {
+      uint32_t raw_gpu_id;
+      uint32_t gpu_variant;
+      uint64_t shader_present;
+   } kbase_props;
+};
+
+bool
+kbase_kmod_backend_available(void)
+{
+   return PAN_KBASE_HEADERS_AVAILABLE;
+}
+
+#if !PAN_KBASE_HEADERS_AVAILABLE
+
+/* No real headers available in this build: refuse cleanly rather than
+ * fabricate an ioctl ABI. This is intentional, see the file header
+ * comment above. */
+struct pan_kmod_dev *
+kbase_kmod_dev_create_from_raw_fd(int fd, UNUSED uint32_t flags,
+                                  UNUSED const struct pan_kmod_allocator *allocator)
+{
+   mesa_loge("kbase backend: not built with mali_kbase_ioctl.h -- "
+             "drop the real kbase headers for your device into "
+             "src/panfrost/base/include/ and rebuild (see kbase_kmod.c)");
+   close(fd);
+   return NULL;
+}
+
+#else /* PAN_KBASE_HEADERS_AVAILABLE */
+
+/*
+ * ---------------------------------------------------------------------
+ * Everything below this line only builds once real headers are present,
+ * and is a *skeleton* to fill in -- each PORT_REQUIRED body is a direct
+ * stand-in for the equivalent function in the old fork's pan_vX_base.c
+ * (see kbase_open(), kbase_get_gpuprops(), kbase_mem_alloc(), etc. in
+ * the uploaded patch). None of the bodies below have been exercised
+ * against real hardware.
+ * ---------------------------------------------------------------------
+ */
+
+static int
+kbase_do_version_check(int fd, uint32_t *major, uint32_t *minor)
+{
+   /* PORT_REQUIRED: probe KBASE_IOCTL_VERSION_CHECK_RESERVED (CSF path)
+    * first, falling back to KBASE_IOCTL_VERSION_CHECK (JM path) the way
+    * kbase_open() does in the old fork -- the two have different struct
+    * layouts and only one will be valid on a given kernel driver, so the
+    * probe order and EINVAL/ENOTTY handling both matter. Transcribe from
+    * pan_vX_base.c rather than reimplementing from scratch. */
+   (void)fd;
+   (void)major;
+   (void)minor;
+   return -ENOSYS;
+}
+
+static int
+kbase_query_gpu_props(struct kbase_kmod_dev *kdev)
+{
+   /* PORT_REQUIRED: KBASE_IOCTL_GET_GPUPROPS is a two-call ioctl (first
+    * call with size=0 to get the required buffer size, second call to
+    * fill it) -- see kbase_ensure_gpuprops() in pan_vX_base.c. Once
+    * filled in, this is the function whose output finally answers the
+    * task's "what is G615's *real* raw GPU_ID2 value" question:
+    * print kdev->kbase_props.raw_gpu_id from
+    * src/panfrost/tools/panfrost_gpuid_probe and compare it against
+    * PAN_PROD_ID(10, 8, 7) (Mali-G610/G710) before assuming G615 needs
+    * its own pan_model.c entry. Do not hardcode a guessed value here. */
+   (void)kdev;
+   return -ENOSYS;
+}
+
+static struct pan_kmod_dev *
+kbase_kmod_dev_create(int fd, uint32_t flags,
+                      const struct pan_kmod_driver *drv_info,
+                      const struct pan_kmod_allocator *allocator)
+{
+   struct kbase_kmod_dev *kdev = pan_kmod_alloc(allocator, sizeof(*kdev));
+   if (!kdev) {
+      mesa_loge("failed to allocate a kbase_kmod_dev object");
+      return NULL;
+   }
+
+   /* NOTE: pan_kmod_dev_init()'s drv_info->version is meaningless here --
+    * it comes from drmGetVersion(), which never ran on a non-DRM fd. Use
+    * kbase_do_version_check()'s result instead once it's implemented. */
+   pan_kmod_dev_init(&kdev->base, fd, flags, drv_info, &kbase_kmod_ops,
+                     allocator);
+
+   uint32_t major, minor;
+   if (kbase_do_version_check(fd, &major, &minor)) {
+      mesa_loge("kbase backend: version check ioctl failed (%s) -- "
+                "either this isn't a kbase device, or the ioctl ABI "
+                "doesn't match what was ported",
+                strerror(errno));
+      goto err_free;
+   }
+
+   if (kbase_query_gpu_props(kdev)) {
+      mesa_loge("kbase backend: failed to query GPU properties");
+      goto err_free;
+   }
+
+   /* PORT_REQUIRED: populate kdev->base.props (gpu_id, gpu_variant,
+    * shader_present, tiler_present, l2_present, num_cs_slots for CSF,
+    * pgsize_bitmap, va bits, etc.) from kdev->kbase_props the way
+    * panfrost_dev_query_props() does for the DRM backend in
+    * panfrost_kmod.c. dev->props.gpu_id must end up holding the raw
+    * 32-bit GPU_ID2 register value unmodified -- do not truncate it to
+    * 16 bits the way the old fork's model table entries for G610/G710
+    * do, since pan_arch()/pan_prod_id() in this tree expect the full
+    * register (see src/panfrost/model/pan_model.h). */
+
+   return &kdev->base;
+
+err_free:
+   pan_kmod_free(allocator, kdev);
+   return NULL;
+}
+
+static void
+kbase_kmod_dev_destroy(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kdev = container_of(dev, struct kbase_kmod_dev, base);
+
+   pan_kmod_dev_cleanup(dev);
+   pan_kmod_free(dev->allocator, kdev);
+}
+
+/* PORT_REQUIRED: the remaining pan_kmod_ops (bo_alloc/bo_free/bo_import/
+ * bo_get_mmap_offset/bo_wait/vm_create/vm_destroy/vm_bind/
+ * query_timestamp/...) all need kbase equivalents. Unlike the DRM
+ * backends, kbase has no separate VM-bind step -- GPU_VA assignment
+ * happens as part of KBASE_IOCTL_MEM_ALLOC / KBASE_IOCTL_MEM_COMMIT, so
+ * vm_bind() here will need to emulate the pan_kmod_vm_op interface on
+ * top of a fundamentally different allocator model. This is the part of
+ * the port most likely to need real design work rather than transcription
+ * -- do not assume it is a mechanical translation the way the ioctl
+ * marshaling mostly is.
+ */
+
+static struct pan_kmod_bo *
+kbase_kmod_bo_alloc(UNUSED struct pan_kmod_dev *dev,
+                    UNUSED struct pan_kmod_vm *exclusive_vm,
+                    UNUSED uint64_t size, UNUSED uint32_t flags)
+{
+   mesa_loge("kbase backend: bo_alloc not ported yet");
+   return NULL;
+}
+
+static void
+kbase_kmod_bo_free(UNUSED struct pan_kmod_dev *dev,
+                   UNUSED struct pan_kmod_bo *bo)
+{
+   unreachable("kbase backend: bo_free not ported yet");
+}
+
+static uint64_t
+kbase_kmod_dev_query_user_va_range(UNUSED struct pan_kmod_dev *dev)
+{
+   mesa_loge("kbase backend: dev_query_user_va_range not ported yet");
+   return 0;
+}
+
+const struct pan_kmod_ops kbase_kmod_ops = {
+   .dev_create = kbase_kmod_dev_create,
+   .dev_destroy = kbase_kmod_dev_destroy,
+   .dev_query_user_va_range = kbase_kmod_dev_query_user_va_range,
+   .bo_alloc = kbase_kmod_bo_alloc,
+   .bo_free = kbase_kmod_bo_free,
+   /* .bo_import, .bo_get_mmap_offset, .bo_wait, .flush_bo_map_syncs,
+    * .bo_make_evictable, .bo_make_unevictable, .vm_create, .vm_destroy,
+    * .vm_bind, .query_timestamp, .bo_set_label: PORT_REQUIRED, left
+    * unset (NULL) so a call into any of them crashes loudly at the
+    * call site instead of pretending to succeed. */
+};
+
+struct pan_kmod_dev *
+kbase_kmod_dev_create_from_raw_fd(int fd, uint32_t flags,
+                                  const struct pan_kmod_allocator *allocator)
+{
+   static const struct pan_kmod_driver drv_info = {0};
+
+   if (!allocator) {
+      static const struct pan_kmod_allocator default_allocator = {
+         .zalloc = NULL, /* PORT_REQUIRED: mirror pan_kmod.c's default_zalloc */
+         .free = NULL,
+      };
+      allocator = &default_allocator;
+   }
+
+   return kbase_kmod_dev_create(fd, flags, &drv_info, allocator);
+}
+
+#endif /* PAN_KBASE_HEADERS_AVAILABLE */
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
new file mode 100644
index 0000000..09eef1f
--- /dev/null
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright © 2026 (community port, unverified)
+ * SPDX-License-Identifier: MIT
+ *
+ * ---------------------------------------------------------------------
+ * STATUS: SCAFFOLD / NOT FUNCTIONAL YET -- see kbase_kmod.c top comment.
+ * ---------------------------------------------------------------------
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "pan_kmod.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * /dev/mali0 is a plain misc character device, not a DRM node, so it does
+ * not answer DRM_IOCTL_VERSION and can't be identified by
+ * pan_kmod_dev_create()'s normal drmGetVersion() probe (see pan_kmod.c).
+ * Callers that want to try the kbase backend must therefore detect the
+ * device out-of-band (e.g. "drmOpenWithType() failed, try opening
+ * /dev/mali0 by hand") and hand the fd to this entry point instead of the
+ * generic pan_kmod_dev_create().
+ *
+ * Returns NULL if this fd doesn't look like a kbase device, or if the
+ * kbase protocol port hasn't been completed for the version reported by
+ * the kernel (see kbase_kmod.c).
+ */
+struct pan_kmod_dev *kbase_kmod_dev_create_from_raw_fd(
+   int fd, uint32_t flags, const struct pan_kmod_allocator *allocator);
+
+/* True if this build was compiled with real kbase ioctl headers dropped
+ * into src/panfrost/base/include/ (see kbase_kmod.c). When false, the
+ * function above always returns NULL -- there is no working fallback,
+ * by design: silently miscompiling the ioctl ABI against a real GPU
+ * driver is worse than refusing to load. */
+bool kbase_kmod_backend_available(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/panfrost/lib/kmod/meson.build b/src/panfrost/lib/kmod/meson.build
index cb021a3..a3591ca 100644
--- a/src/panfrost/lib/kmod/meson.build
+++ b/src/panfrost/lib/kmod/meson.build
@@ -5,6 +5,11 @@ libpankmod_lib_files = files(
   'pan_kmod.c',
   'panfrost_kmod.c',
   'panthor_kmod.c',
+  # Scaffold for the out-of-tree "kbase" (/dev/mali0, Android) backend.
+  # Builds to a stub that always fails cleanly unless real kbase ioctl
+  # headers are dropped into src/panfrost/base/include/ -- see the top
+  # comment in kbase_kmod.c before enabling PAN_KMOD_KBASE downstream.
+  'kbase_kmod.c',
 )
 
 libpankmod_lib = static_library(
diff --git a/src/panfrost/model/pan_model.c b/src/panfrost/model/pan_model.c
index 22fb4f7..2ddccc1 100644
--- a/src/panfrost/model/pan_model.c
+++ b/src/panfrost/model/pan_model.c
@@ -4,6 +4,10 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
 #include "pan_model.h"
 
 /* Fixed "minimum revisions" */
@@ -87,6 +91,35 @@ const struct pan_model pan_model_list[] = {
                                               MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
    VALHALL_MODEL(PAN_PROD_ID(10, 8, 7), 0, "G610",   "G710", MODEL_ANISO(ALL),  MODEL_TB_SIZES(32768, 16384),
                                               MODEL_RATES_X(4, 8, 16,  64,  64, 16)),
+   /*
+    * Mali-G615 (arch 11, "4th-gen Valhall", same generation as G715) is
+    * NOT the same generation as G610/G710 above (arch 10) despite the
+    * similar marketing number, and does not have an entry here.
+    *
+    * A community fork (icecream95's Panfork, kbase/Android branch) once
+    * hardcoded MODEL(0xb8a31030, "G615", ...) as a raw 32-bit gpu_id.
+    * Decoding that literal with this file's own PAN_ARCH_MAJOR/MINOR/
+    * PRODUCT_MAJOR macros gives arch_major=11, arch_minor=8, arch_rev=10,
+    * product_major=3 -- i.e. it already claims to be arch 11, but that
+    * value was apparently never confirmed against a real device (the
+    * same fork's commit history flip-flops the surrounding anisotropic-
+    * filtering flag and briefly shipped an outright syntax error next to
+    * it), so it should be treated as unverified, not copied in here.
+    *
+    * Do NOT add a Mali-G615 entry by guessing. Instead:
+    *   1. Build src/panfrost/tools/panfrost_gpuid_probe and run it
+    *      against the real device (needs a working panfrost/panthor DRM
+    *      node, or the kbase backend in ../lib/kmod/kbase_kmod.c once
+    *      that's been ported for the device -- see that file).
+    *   2. Add VALHALL_MODEL(PAN_PROD_ID(arch_major, arch_minor,
+    *      product_major), variant, "G615", ...) here using the numbers
+    *      the probe tool prints, not a copied literal.
+    *   3. Separately confirm arch 11 has command-stream support in this
+    *      tree at all (it doesn't, as of this writing -- there is no
+    *      v11.xml/v11_pack.h and pan_screen.c's arch switch has no
+    *      `case 11`). Fixing the model table alone will not make a G615
+    *      device render anything.
+    */
    /* var/cvt/sfu rates might not be correct (we haven't found any detailed documentation) */
    VALHALL_MODEL(PAN_PROD_ID(10, 12, 4), 0, "G310v1",   "G710", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
                                               MODEL_RATES_X(2, 2,  8,  16,  16, 4)),
@@ -131,6 +164,39 @@ const struct pan_model pan_model_list[] = {
 #undef MODEL_RATES
 #undef MODEL_QUIRKS
 
+/*
+ * Generic fallback used when PAN_MESA_ALLOW_UNKNOWN_MODEL=1 is set and
+ * gpu_id doesn't match any entry above (e.g. a real Mali-G615 MC2, whose
+ * gpu_prod_id doesn't match anything here yet -- see the comment above
+ * the G610 entry). Deliberately conservative rather than fast:
+ *
+ *   - min_rev_anisotropic = ~0 (NO_ANISO) so the driver never turns on
+ *     anisotropic filtering paths we haven't verified this GPU handles,
+ *     which is the kind of thing that causes GPU faults under real game
+ *     load rather than a clean error.
+ *   - tilebuffer sized small (8192) rather than guessed large, since an
+ *     oversized tilebuffer relative to real hardware limits is a much
+ *     worse failure mode (corruption/hangs) than an undersized one
+ *     (correctness preserved, just more tile passes / lower FPS).
+ *   - rates left at 0 ("can't be determined"), and no quirks assumed.
+ *
+ * This exists purely to let you get FPS numbers off hardware this table
+ * doesn't recognize yet; it is not a substitute for adding a real
+ * pan_model_list[] entry once the true gpu_id is known (see
+ * panfrost_gpuid_probe), and it stays opt-in via the env var so it can
+ * never silently change behavior for GPUs this file already supports.
+ */
+static const struct pan_model pan_unknown_model = {
+   .gpu_prod_id = 0,
+   .gpu_variant = 0,
+   .name = "Unknown Mali GPU (generic Valhall/Bifrost fallback)",
+   .performance_counters = "",
+   .min_rev_anisotropic = ~0u,
+   .tilebuffer = {.color_size = 8192, .z_size = 8192},
+   .rates = {0},
+   .quirks = {0},
+};
+
 /*
  * Look up a supported model by its GPU ID, or return NULL if the model is not
  * supported at this time.
@@ -145,5 +211,19 @@ pan_get_model(uint64_t gpu_id, uint32_t gpu_variant)
          return &pan_model_list[i];
    }
 
+   if (getenv("PAN_MESA_ALLOW_UNKNOWN_MODEL")) {
+      fprintf(stderr,
+              "panfrost: unrecognized gpu_id = 0x%016" PRIx64
+              " (prod_id=0x%06x arch_major=%u arch_minor=%u "
+              "product_major=%u variant=%u) -- continuing with generic "
+              "fallback model because PAN_MESA_ALLOW_UNKNOWN_MODEL=1. "
+              "This is for bring-up/FPS testing only: send this line back "
+              "so a real pan_model_list[] entry can be added.\n",
+              gpu_id, gpu_prod_id, PAN_ARCH_MAJOR(gpu_id),
+              PAN_ARCH_MINOR(gpu_id), PAN_PRODUCT_MAJOR(gpu_id),
+              gpu_variant);
+      return &pan_unknown_model;
+   }
+
    return NULL;
 }
diff --git a/src/panfrost/tools/meson.build b/src/panfrost/tools/meson.build
index 2d5bef1..35f9bf8 100644
